# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file — it holds secrets.

# Get this from @BotFather on Telegram after creating your bot.
TELEGRAM_BOT_TOKEN=

# Get this from https://console.anthropic.com/ (needed once we add AI replies).
ANTHROPIC_API_KEY=

# Optional: comma-separated Telegram chat IDs allowed to run /stats.
# Message @userinfobot on Telegram to find your own numeric chat ID.
ADMIN_CHAT_IDS=
